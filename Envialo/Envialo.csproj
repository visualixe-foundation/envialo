<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>envialo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="envialo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="envialo.ico" />
  </ItemGroup>

</Project>
