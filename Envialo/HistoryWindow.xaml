<Window x:Class="Envialo.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envíalo - Transfer History"
        Icon="envialo.ico"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#221F1D"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="📜 Transfer History"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                BorderBrush="#4A4540"
                BorderThickness="1"
                CornerRadius="12"
                Background="#2B2724">

            <ListBox Name="HistoryList"
                     Foreground="White"
                     FontSize="13"
                     FontFamily="Consolas"
                     Padding="8"/>

        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="🗑️ Clear History"
                    Width="140"
                    Height="36"
                    Click="ClearHistory_Click"/>

            <Button Content="Close"
                    Width="100"
                    Height="36"
                    Margin="10,0,0,0"
                    Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
