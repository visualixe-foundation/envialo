<Window x:Class="Envialo.PinLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Envíalo"
        Icon="envialo.ico"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#221F1D"
        SizeToContent="Height"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Name="TitleText"
                   Text="Envíalo"
                   Foreground="White"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Name="SubtitleText"
                   Text="Welcome back! Enter your PIN 🔐"
                   Foreground="#AAAAAA"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- PIN entry (used for: enter existing PIN, set a new PIN) -->
        <PasswordBox Grid.Row="2"
                     Name="PinBox"
                     Width="200"
                     Height="42"
                     FontSize="24"
                     MaxLength="4"
                     HorizontalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     PasswordChar="●"
                     KeyDown="PinBox_KeyDown"/>

        <!-- Security question SETUP fields (shown right after choosing a new PIN) -->
        <StackPanel Grid.Row="2"
                    Name="SetupQuestionPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Width="260">
            <TextBlock Text="Write a security question only you know the answer to:"
                       Foreground="#CCCCCC"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <TextBox Name="SetupQuestionBox"
                     Height="34"
                     FontSize="14"
                     Margin="0,0,0,10"/>
            <TextBlock Text="Your answer:"
                       Foreground="#CCCCCC"
                       FontSize="13"
                       Margin="0,0,0,8"/>
            <TextBox Name="SetupAnswerBox"
                     Height="34"
                     FontSize="14"
                     KeyDown="SetupAnswerBox_KeyDown"/>
        </StackPanel>

        <!-- Forgot-PIN: shows the stored question, takes their answer -->
        <StackPanel Grid.Row="2"
                    Name="ForgotPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Width="260">
            <TextBlock Name="StoredQuestionText"
                       Foreground="#CCCCCC"
                       FontSize="14"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
            <TextBox Name="ForgotAnswerBox"
                     Height="34"
                     FontSize="14"
                     KeyDown="ForgotAnswerBox_KeyDown"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Name="ErrorText"
                   Foreground="#FF8A6B"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Width="280"
                   Margin="0,15,0,0"
                   Visibility="Collapsed"/>

        <Button Grid.Row="4"
                Name="SubmitButton"
                Content="Continue"
                Width="170"
                Height="42"
                FontSize="15"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Click="SubmitButton_Click"/>

        <!-- "Forgot your PIN?" link, only visible on the enter-PIN screen -->
        <TextBlock Grid.Row="5"
                   Name="ForgotPinLink"
                   Text="Forgot your PIN? 🤔"
                   Foreground="#FF9142"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Cursor="Hand"
                   Margin="0,14,0,0"
                   MouseLeftButtonUp="ForgotPinLink_Click"
                   Visibility="Collapsed"/>

        <!-- "Back" link, shown during the forgot-PIN flow -->
        <TextBlock Grid.Row="6"
                   Name="BackLink"
                   Text="← Back"
                   Foreground="#999999"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Cursor="Hand"
                   Margin="0,10,0,0"
                   MouseLeftButtonUp="BackLink_Click"
                   Visibility="Collapsed"/>

    </Grid>
</Window>
